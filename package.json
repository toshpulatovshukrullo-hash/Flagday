{
  "name": "flagday-35",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Uzbekistan State Flag Day anniversary 3D animation (Remotion + React Three Fiber)",
  "scripts": {
    "studio": "remotion studio",
    "typeface": "node scripts/make_typeface.mjs",
    "test:flag": "node scripts/test_flag_texture.mjs",
    "stills": "node scripts/render_stills.mjs",
    "render:9x16": "remotion render FlagDay out/flagday_9x16.mp4 --gl=swangle --crf=16 --pixel-format=yuv420p",
    "render:1x1": "remotion render FlagDay1x1 out/flagday_1x1.mp4 --gl=swangle --crf=16 --pixel-format=yuv420p",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@remotion/cli": "4.0.544",
    "@remotion/three": "4.0.544",
    "postprocessing": "6.38.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "remotion": "4.0.544",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.80",
    "@types/react": "19.2.2",
    "@types/three": "0.180.0",
    "opentype.js": "1.3.4",
    "typescript": "5.9.3"
  }
}
